<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless runner. Add it to MO2 as an executable so it sees the VFS + profile load order. -->
  <PropertyGroup>
    <ApplicationIcon>../../assets/pengulod.ico</ApplicationIcon>
    <OutputType>Exe</OutputType>
    <RootNamespace>PenguLOD.Cli</RootNamespace>
    <AssemblyName>PenguLOD</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PenguLOD.Configuration/PenguLOD.Configuration.csproj" />
    <ProjectReference Include="..\PenguLOD.Core\PenguLOD.Core.csproj" />
    <ProjectReference Include="..\PenguLOD.Plugins\PenguLOD.Plugins.csproj" />
  </ItemGroup>
</Project>
