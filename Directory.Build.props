<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CI sets PENGULOD_WARNINGS_AS_ERRORS=1 for the Linux build and test steps. Dependency advisories remain warnings. -->
    <TreatWarningsAsErrors Condition="'$(PENGULOD_WARNINGS_AS_ERRORS)' == '1'">true</TreatWarningsAsErrors>
    <TreatWarningsAsErrors Condition="'$(PENGULOD_WARNINGS_AS_ERRORS)' != '1'">false</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <PlatformTarget>x64</PlatformTarget>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- The .NET 10 SDK marks the launcher exe as CET shadow stack compatible. MO2's usvfs hooks break that: the exe crashes at
         start (0xC0000005 in an unknown module) when started from MO2's executables list. Off, it starts in MO2 like any other tool. -->
    <CETCompat>false</CETCompat>
    <!-- PenguLOD generator and game-runtime releases share VERSION; upstream provenance uses UPSTREAM_VERSION. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version>
    <Authors>CageTV;opteron-x86;PenguLOD contributors</Authors>
    <Product>PenguLOD</Product>
    <RepositoryUrl>https://github.com/opteron-x86/PenguLOD</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <!-- Normalizes the source paths baked into the .pdb files and the .dll debug directory to "/_/..." instead of the
         absolute path of whatever machine built the release (which included the builder's folder names). -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="AnvilLODUpstreamVersion" Value="$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)UPSTREAM_VERSION').Trim())" />
  </ItemGroup>
</Project>
