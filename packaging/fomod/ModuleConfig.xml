<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
    <moduleName>PenguLOD SKSE Plugin</moduleName>
    <moduleImage path="fomod\images\pengulod.png" />
    <requiredInstallFiles>
        <file source="common\SKSE\Plugins\PenguLOD.ini" destination="SKSE\Plugins\PenguLOD.ini" />
    </requiredInstallFiles>
    <installSteps order="Explicit">
        <installStep name="Game version">
            <optionalFileGroups order="Explicit">
                <group name="Select your Skyrim Version:" type="SelectExactlyOne">
                    <plugins order="Explicit">
                        <plugin name="SE 1.5.97 up to AE 1.6.1170">
                            <description>1.5.97/1.6.x</description>
                            <image path="fomod\images\pengulod.png" />
                            <files>
                                <folder source="1.5.97-1.6.1170\SKSE" destination="SKSE" priority="0" />
                            </files>
                            <typeDescriptor>
                                <type name="Optional" />
                            </typeDescriptor>
                        </plugin>
                        <plugin name="Newer than 1.6.1170 (1.7.99, 1.7.104 and later)">
                            <description>1.7.x</description>
                            <image path="fomod\images\pengulod.png" />
                            <files>
                                <folder source="1.7.x\SKSE" destination="SKSE" priority="0" />
                            </files>
                            <typeDescriptor>
                                <type name="Optional" />
                            </typeDescriptor>
                        </plugin>
                        <plugin name="Skyrim VR 1.4.15">
                            <description>VR 1.4.15</description>
                            <image path="fomod\images\pengulod.png" />
                            <files>
                                <folder source="1.4.15-VR\SKSE" destination="SKSE" priority="0" />
                            </files>
                            <typeDescriptor>
                                <type name="Optional" />
                            </typeDescriptor>
                        </plugin>
                    </plugins>
                </group>
            </optionalFileGroups>
        </installStep>
    </installSteps>
</config>
