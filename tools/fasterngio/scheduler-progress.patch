+TEST(TbbGraphScheduler, DispatchDoesNotDependOnTheCallingArena)
+{
+	auto scheduler = Pipeline::MakeTbbGraphScheduler();
+	auto scope = scheduler->CreateScope("external writer");
+	std::promise<void> completed;
+	auto done = completed.get_future();
+	// An external callback may run in a different arena. The graph promises
+	// its own workers; it must not strand a wakeup in the caller's arena.
+	oneapi::tbb::task_arena caller(2, 2);
+	caller.execute([&] {
+		EXPECT_TRUE(scheduler->Dispatch(scope, {}, org::async::TaskDispatch::Cpu, "resume",
+			[&](const org::async::TaskContext&) { completed.set_value(); }));
+	});
+	EXPECT_EQ(done.wait_for(std::chrono::seconds(2)), std::future_status::ready);
+	// Also cleans up the old implementation when this regression test fails.
+	caller.execute([&] { scope->Wait(); });
+}
