+TEST(CellPipeline, ResumesEveryCellAfterWriterBackpressure)
+{
+	oneapi::tbb::global_control threads(oneapi::tbb::global_control::max_allowed_parallelism, 32);
+	EmptyWorld world;
+	world.lands.clear();
+	for (std::int32_t x = 0; x < 4096; ++x) {
+		auto& land = world.lands.emplace_back();
+		land.cellX = x;
+		land.cellY = -1;
+		land.hasHeights = true;
+	}
+	auto tally = std::make_shared<Pipeline::WriteTally>();
+	// Even a four-byte empty cache exceeds this budget. Force many workers
+	// through the writer's suspension/resume handshake, including its last file.
+	Pipeline::FileWriterPool writer(1, 1);
+	auto desc = world.Desc();
+	desc.writer = &writer;
+	desc.writeTally = tally;
+	const auto stats = Pipeline::RunCellPipeline(desc);
+	writer.Drain();
+	EXPECT_EQ(stats.cellsWritten, 4096u);
+	EXPECT_EQ(stats.cellsFailed, 0u);
+	EXPECT_EQ(tally->written.load(), 4096u);
+	EXPECT_EQ(writer.PendingFiles(), 0u);
 }
 
