+	// The CLI is also AnvilLOD's backend: keep redirected logs useful during a
+	// long world, including the writer drain after the last cell was processed.
+	void ReportProgress(const FasterNGIO::App::RunProgress& a_progress, std::stop_token a_stop)
+	{
+		using namespace FasterNGIO::App;
+		using Clock = std::chrono::steady_clock;
+		const auto begin = Clock::now();
+		auto changedAt = begin;
+		auto nextReport = begin + std::chrono::seconds(5);
+		std::tuple<RunStage, std::uint32_t, std::uint32_t, std::uint64_t> previous{};
+		bool warned = false;
+		while (!a_stop.stop_requested()) {
+			std::this_thread::sleep_for(std::chrono::milliseconds(100));
+			if (a_stop.stop_requested()) break;
+			const auto now = Clock::now();
+			const auto stage = a_progress.stage.load(std::memory_order_relaxed);
+			const auto world = a_progress.worldIndex.load(std::memory_order_relaxed);
+			const auto cells = a_progress.cellsDone.load(std::memory_order_relaxed);
+			const auto files = a_progress.filesWritten.load(std::memory_order_relaxed);
+			const auto current = std::tuple{ stage, world, cells, files };
+			if (current != previous) {
+				previous = current;
+				changedAt = now;
+				warned = false;
+			}
+			if (!warned && (stage == RunStage::Generating || stage == RunStage::Writing) && now - changedAt >= std::chrono::seconds(120)) {
+				spdlog::warn("no cell/write progress for 120s; generation may be stalled. AnvilLOD can cancel this run without replacing the installed cache");
+				warned = true;
+			}
+			if (now < nextReport || stage == RunStage::Finished) continue;
+			nextReport = now + std::chrono::seconds(5);
+			const auto elapsed = std::chrono::duration<double>(now - begin).count();
+			if (stage == RunStage::LoadingPlugins) {
+				spdlog::info("progress: loading plugins and assets; elapsed {:.0f}s", elapsed);
+			} else if (stage == RunStage::Writing) {
+				spdlog::info("progress: finishing disk writes; {} files written; elapsed {:.0f}s", files, elapsed);
+			} else {
+				spdlog::info("progress: {} world {}/{} (0x{:08X}); cells processed {}/{}; {} files written; elapsed {:.0f}s",
+					stage == RunStage::Preparing ? "preparing" : "generating",
+					world + 1, a_progress.worldCount.load(std::memory_order_relaxed), a_progress.worldFormID.load(std::memory_order_relaxed),
+					cells, a_progress.cellsTotal.load(std::memory_order_relaxed), files, elapsed);
+			}
+		}
+	}
