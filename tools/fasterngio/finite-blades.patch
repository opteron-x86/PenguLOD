+TEST(FinalizeCell, OmitsUnrepresentableBladesWithoutChangingValidPayloads)
+{
+	GameData::GrassInfo grass{};
+	auto valid = MakeCell(grass);
+	AddBlade(valid, 10.0f, 20.0f, 30.0f);
+	AddBlade(valid, 10.0f, 20.0f, -65504.0f);
+	const auto expected = Grass::SerializeNgioCellCache(Grass::FinalizeCell(valid, {}).cache);
+	auto mixed = valid;
+	// A finite world height can overflow the encoded half float. Also exercise
+	// NaN/infinity in every stored position component and the scale component.
+	AddBlade(mixed, 10.0f, 20.0f, -70000.0f);
+	for (std::size_t axis = 0; axis < 4; ++axis) {
+		AddBlade(mixed, 10.0f, 20.0f, 30.0f);
+		mixed.blades.back().words[axis] = axis % 2 ? 0x7E00u : 0x7C00u;
+	}
+	const auto result = Grass::FinalizeCell(mixed, {});
+	EXPECT_EQ(result.bladesInvalid, 5u);
+	EXPECT_EQ(Grass::SerializeNgioCellCache(result.cache), expected);
+	// Cells containing only invalid blades still emit the valid empty cache,
+	// suppressing an older installed cache at that coordinate.
+	mixed.blades.erase(mixed.blades.begin(), mixed.blades.begin() + 2);
+	const auto empty = Grass::FinalizeCell(mixed, {});
+	EXPECT_EQ(empty.bladesInvalid, 5u);
+	EXPECT_EQ(Grass::SerializeNgioCellCache(empty.cache), (std::vector<std::uint8_t>{ 0, 0, 0, 0 }));
+	const std::uint32_t rejected = 0xFFFFFFFFu;
+	EXPECT_EQ(Grass::FinalizeCell(mixed, std::span(&rejected, 1)).bladesInvalid, 0u);
+}
